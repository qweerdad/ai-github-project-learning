+/* ---------- Task Note (tutorial feature) ---------- */
+/* 每个任务下方的一行备注：平时只读显示，点击进入编辑 */
+.task-note {
+    flex-basis: 100%;
+    margin: -6px 0 0 66px;
+    min-width: 0;
+}
+
+.task-note-preview {
+    display: block;
+    width: 100%;
+    padding: 0;
+    border: none;
+    background: none;
+    font: inherit;
+    font-size: 0.8rem;
+    line-height: 1.5;
+    color: var(--text-secondary);
+    text-align: left;
+    cursor: text;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.note-hint {
+    color: var(--text-muted);
+    font-style: italic;
+    opacity: 0.55;
+    transition: opacity var(--transition-fast);
+}
+
+.task-item:hover .note-hint {
+    opacity: 0.9;
+}
+
+.task-note-input {
+    width: 100%;
+    padding: 3px 8px;
+    font: inherit;
+    font-size: 0.8rem;
+    color: var(--text-primary);
+    background: var(--bg-secondary);
+    border: 1px solid var(--accent-primary);
+    border-radius: var(--radius-sm);
+    outline: none;
+}
+
+.task-item.completed .task-note-preview {
+    text-decoration: line-through;
+    color: var(--text-muted);
+}
